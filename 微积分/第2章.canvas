{
	"nodes":[
		{"id":"c42c9ac3fd275217","type":"text","text":"**函数极限**","x":-125,"y":-30,"width":105,"height":50,"color":"4"},
		{"id":"dc950622028e1f5d","x":60,"y":-120,"width":107,"height":50,"type":"text","text":"基本定义"},
		{"id":"c2bcb6c2734a5ca3","x":60,"y":-30,"width":101,"height":50,"type":"text","text":"基本性质"},
		{"id":"02cff4253594df0e","x":260,"y":-240,"width":247,"height":64,"type":"text","text":"类似数列，$x \\in \\mathring{U}(x_0, \\delta) \\cap D$ 时，$\\left| f (x) - A \\right| <   \\varepsilon$"},
		{"id":"82c5b644b7ded006","x":260,"y":-95,"width":99,"height":50,"type":"text","text":"归结原理"},
		{"id":"00a3bc05b24fcd0f","x":480,"y":-100,"width":286,"height":60,"type":"text","text":"函数与其对应数列的极限相互对应"},
		{"id":"08239f5be65c7df8","x":260,"y":-30,"width":91,"height":50,"type":"text","text":"唯一性"},
		{"id":"ed99bc8d77961fd7","x":260,"y":40,"width":151,"height":59,"type":"text","text":"局部有界、保号"},
		{"id":"872ae6c06d6ee5bf","x":480,"y":40,"width":147,"height":59,"type":"text","text":"极限大小比较与函数大小比较"},
		{"id":"09fccdf16cac304b","x":260,"y":120,"width":102,"height":50,"type":"text","text":"夹逼定理"},
		{"id":"a5ae941866561594","x":260,"y":200,"width":142,"height":50,"type":"text","text":"四则运算法则"},
		{"id":"071b3a3b9517eec9","x":260,"y":280,"width":237,"height":50,"type":"text","text":"单侧极限与无穷远处的极限"},
		{"id":"c316a4d6d3698505","x":-135,"y":99,"width":125,"height":60,"type":"text","text":"局部连续性"},
		{"id":"e2095a618025b577","x":-309,"y":305,"width":86,"height":50,"type":"text","text":"间断点"},
		{"id":"2a129af539353aa2","x":-141,"y":305,"width":131,"height":55,"type":"text","text":"一致连续性"},
		{"id":"62c34f52a801c7ff","x":-201,"y":420,"width":251,"height":60,"type":"text","text":"基本想法：两个横坐标有限接近的点，纵坐标也有限接近"},
		{"id":"f2960bc64e5a444a","x":-331,"y":-95,"width":100,"height":50,"type":"text","text":"无穷大量"},
		{"id":"90799689aa0d9b55","x":-331,"y":-195,"width":100,"height":50,"type":"text","text":"无穷小量"},
		{"id":"5c10089db98b8ac9","x":-620,"y":-229,"width":250,"height":119,"type":"text","text":"如果  $\\lim_{x\\to x_{0}}f(x)=0$ ，就称  $f(x)$  是当  $x\\to x_{0}$  时的**无穷小量**，简称**无穷小**.无穷小是极限为0的变量"},
		{"id":"3f02d49375ebe75b","x":-620,"y":-102,"width":250,"height":65,"type":"text","text":"取无穷小的倒数\n仅表示变化趋势而非具体极限"},
		{"id":"86214a8f8dde276b","x":-175,"y":-258,"width":205,"height":50,"type":"text","text":"无穷大与无穷小的比较"},
		{"id":"05dc8f273f670814","x":-144,"y":-145,"width":144,"height":50,"type":"text","text":"无穷大与无穷小"},
		{"id":"fb9062d175f239bc","x":-154,"y":-360,"width":164,"height":55,"type":"text","text":"无穷大/小的阶数"},
		{"id":"3066796e7aaec154","x":-154,"y":-480,"width":164,"height":53,"type":"text","text":"乘法/除法法则"},
		{"id":"bc20be264cb22bc1","x":-489,"y":-358,"width":238,"height":52,"type":"text","text":"比较：以x的多项式为基准比较（定义）无穷量的阶数"},
		{"id":"5f5776c9c7ec66e1","x":-740,"y":-357,"width":169,"height":50,"type":"text","text":"k阶无穷大/无穷小"},
		{"id":"58f0f8cf373d6747","x":101,"y":-360,"width":120,"height":55,"type":"text","text":"同阶无穷小"},
		{"id":"60ca023250fefb0f","x":288,"y":-360,"width":191,"height":55,"type":"text","text":" $\\lim_{x\\to x_0}\\frac{f(x)}{g(x)} = A\\neq 0$"},
		{"id":"f046e55b8f7a7dda","x":305,"y":-480,"width":174,"height":55,"type":"text","text":"$\\lim_{x\\to x_0}\\frac{f(x)}{g(x)} = 1$"},
		{"id":"04e6723d834ce0d4","x":101,"y":-480,"width":120,"height":55,"type":"text","text":"等阶无穷小"},
		{"id":"bc3cce7d0ad689fc","x":-440,"y":-20,"width":217,"height":60,"type":"text","text":"基本想法：${}x_{0}{}$处有定义且左右极限均等于${}f(x_{0}){}$"},
		{"id":"87b2173730377902","x":-370,"y":104,"width":147,"height":50,"type":"text","text":"连续函数的性质"},
		{"id":"497c41fc5b56cd57","x":-704,"y":61,"width":168,"height":60,"type":"text","text":"零点存在定理"},
		{"id":"d7fc46e3f9fc8f53","x":-704,"y":137,"width":168,"height":60,"type":"text","text":"介值定理"},
		{"id":"869a51940bd84fe3","x":-704,"y":-30,"width":168,"height":74,"type":"text","text":"闭区间上的有界性和最大最小值定理"},
		{"id":"f02be906e807484e","x":-704,"y":220,"width":168,"height":60,"type":"text","text":"不动点定理"},
		{"id":"652f49f6bccc49d7","x":-993,"y":385,"width":237,"height":60,"type":"text","text":"左右极限存在但${}x_{0}{}$处不连续"},
		{"id":"14184d352723f176","x":-667,"y":390,"width":131,"height":50,"type":"text","text":"第一类间断点"},
		{"id":"229ece6c0228c520","x":-867,"y":465,"width":111,"height":51,"type":"text","text":"可去间断点"},
		{"id":"1c900c50e089eb8e","x":-1147,"y":466,"width":201,"height":50,"type":"text","text":"极限存在但不等于${}f(x_{0}){}$，或${}f(x_{0}){}$无定义"},
		{"id":"b13007af91a919be","x":-667,"y":535,"width":131,"height":50,"type":"text","text":"第二类间断点"},
		{"id":"a88a4aa347b234ed","x":-1005,"y":585,"width":249,"height":51,"type":"text","text":"左右极限至少有一个不存在"},
		{"id":"6c3306f07230aed3","x":-1098,"y":305,"width":152,"height":55,"type":"text","text":"左右极限不相等"},
		{"id":"969afa65a38110d9","x":-867,"y":305,"width":111,"height":55,"type":"text","text":"跳跃间断点"},
		{"id":"c500761f7ee67665","x":-1177,"y":61,"width":344,"height":60,"type":"text","text":"f 在  $[a, b]$  上连续且  $f(a)f(b) < 0$ ，则存在  $\\xi \\in (a, b)$ ，使得  $f(\\xi) = 0$ ."},
		{"id":"c191887a26a5d27b","x":-1214,"y":220,"width":381,"height":60,"type":"text","text":"设 $f: [a, b] \\to [a, b]$ 是连续函数，则至少存在一点 $c \\in [a, b]$，使得 $f(c)=c$；称 $c$ 为 $f$ 的不动点。"}
	],
